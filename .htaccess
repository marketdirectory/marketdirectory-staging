<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
  # Staging deploy manifests must not be cached across release checks.
  <FilesMatch "^(?:deploy-info|asset-retention)\.json$">
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>

  # Browser security defaults; CSP/HSTS require dedicated compatibility testing.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  # Observation only. This does not block any content. Inspect browser console
  # and hosted response headers before designing an enforcing CSP. https: is
  # deliberately permissive for current maps, Stripe, analytics and image hosts.
  Header always set Content-Security-Policy-Report-Only "default-src 'self' https: data: blob:; object-src 'none'; base-uri 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; frame-src https:; font-src 'self' https: data:"

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|mjs|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Defence in depth for an accidentally copied configuration/metadata file.
# Never publish .env, git internals, private keys or local QA configurations.
<FilesMatch "^(?:\.env(?:\..*)?|\.git(?:ignore|modules|attributes)?|\.npmrc|\.htaccess|\.htpasswd|.*\.(?:pem|key|p12|pfx))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deny hidden configuration and git internals before SPA fallback or
  # the existing-file shortcut; never depend only on FilesMatch.
  RewriteRule "(^|/)\.(?:git(?:/|$)|env(?:\.[^/]+)?$|npmrc$|htaccess$|htpasswd$)" - [F,L,NC]
  RewriteRule "\.(?:pem|key|p12|pfx)$" - [F,L,NC]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing hashed assets must return 404. Returning index.html here makes
  # browsers treat HTML as JavaScript/CSS and can white-screen open tabs.
  RewriteRule ^assets/ - [L]

  RewriteRule . /index.html [L]
</IfModule>

# STAGING-CSP-BASELINE-BEGIN -- staging output only; do not add to shared public/.htaccess
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "upgrade-insecure-requests; object-src 'none'; base-uri 'self'"
</IfModule>
# STAGING-CSP-BASELINE-END
